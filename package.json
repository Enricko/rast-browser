{
  "manifest": {
    "schemaVersion": 1,
    "kind": "rast-package",
    "id": "browser",
    "type": "app",
    "name": "Browser",
    "description": "A built-in web viewer: opens public HTTPS pages through RAST's sandboxed page proxy.",
    "homepage": "https://github.com/Enricko/rast-browser",
    "license": "MIT",
    "publisher": {
      "id": "enricko",
      "name": "Enricko",
      "url": "https://github.com/Enricko"
    },
    "minRastVersion": "0.11.13",
    "runtime": {
      "executables": [
        {
          "name": "browser",
          "path": "bin/browser"
        }
      ],
      "checks": [
        {
          "executable": "browser",
          "args": [
            "--version"
          ],
          "expect": "Browser {version}"
        }
      ]
    },
    "app": {
      "kind": "web",
      "entry": "index.html"
    }
  },
  "source": {
    "version": "1.0.3",
    "url": "https://github.com/Enricko/rast-browser",
    "sha256": "126b0031cf98d3d76c35240f00932a76e58f93e7d8b01aacfa0d4c40c27164e6"
  },
  "targets": {
    "linux-x86_64": "ubuntu-24.04",
    "linux-aarch64": "ubuntu-24.04-arm"
  }
}
